# izle behind Caddy (HTTPS, automatic certificate); replace izle.example.org with your domain. Why each line is here:
# docs/deploy/self-hosting.md (§6). No access log (request paths carry media proxy tokens and pairing codes) and no
# `encode` (it would buffer the TVs' live event stream).

izle.example.org {
	header Strict-Transport-Security "max-age=31536000"

	# Optional: answer the admin page and the admin API only on your LAN (or VPN). TVs never use them.
	# @admin_outside {
	# 	path /admin /admin/* /api/v1/admin/*
	# 	not remote_ip private_ranges
	# }
	# respond @admin_outside 403

	reverse_proxy 127.0.0.1:8787 {
		# Hand server-sent events, the pairing long-poll and proxied media to the TV as they arrive.
		flush_interval -1
	}
}
