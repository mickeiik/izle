{
  "listen": { "host": "0.0.0.0", "port": 8787 },
  "dataDir": "../../data/example",
  "catalog": { "dir": "./catalog" },
  "resolver": {
    "module": "./index.js",
    "config": { "apiBase": "http://127.0.0.1:8788/", "apiKey": "example-api-key" }
  },
  "proxy": { "alignTsSegments": true, "privateUpstreams": ["127.0.0.1:8788"] },
  "defaults": { "uiLanguage": "en", "preferredAudioLanguage": "en" },
  "log": { "level": "info" },
  "appUpdates": { "source": "manual" }
}
